erDiagram
    USER ||--o{ CART : owns
    USER ||--o{ ORDER : places
    RESTAURANT ||--o{ CART : context
    RESTAURANT ||--o{ ORDER : fulfills
    MENU_ITEM ||--o{ CART_ITEM : references
    MENU_ITEM ||--o{ ORDER_ITEM : snapshots
    COUPON ||--o{ CART : applies
    COUPON ||--o{ ORDER : applies
    CART ||--o{ CART_ITEM : embeds
    ORDER ||--o{ ORDER_ITEM : embeds
    ORDER ||--o{ STATUS_HISTORY : embeds

    USER {
        ObjectId _id PK
        string email UK
        string role
        string status
    }

    RESTAURANT {
        ObjectId _id PK
        ObjectId ownerId FK
        string name
        string operationStatus
        number deliveryFee
    }

    MENU_ITEM {
        ObjectId _id PK
        ObjectId restaurantId FK
        string name
        number basePrice
        number salePrice
        boolean isAvailable
    }

    CART {
        ObjectId _id PK
        ObjectId userId FK
        ObjectId restaurantId FK
        ObjectId couponId FK
        number subtotal
        number discountAmount
        number grandTotal
    }

    CART_ITEM {
        ObjectId menuItemId FK
        number quantity
        number price
    }

    ORDER {
        ObjectId _id PK
        string orderNumber UK
        string checkoutKey
        ObjectId customerId FK
        ObjectId restaurantId FK
        number pricingGrandTotal
        string paymentStatus
        string orderStatus
    }

    ORDER_ITEM {
        ObjectId menuItemId FK
        string name
        number quantity
        number finalUnitPrice
        number lineTotal
    }

    STATUS_HISTORY {
        string from
        string to
        ObjectId changedBy FK
        string changedByRole
        Date changedAt
    }

    COUPON {
        ObjectId _id PK
        string code UK
        string discountType
        number discountValue
        number minOrderAmount
        number maxDiscountAmount
        string status
    }
