flowchart LR
    U["Customer"] -->|"join:order(orderId)"| G["Socket.IO Gateway"]
    M["Merchant"] -->|"join:restaurant<br/>cần bổ sung"| G
    G --> AUTH["JWT handshake + authorization"]
    AUTH --> RO["order:{orderId}"]
    AUTH --> RM["restaurant:{restaurantId}"]
    O["Order Service"] -->|"save Order first"| DB[("MongoDB")]
    DB --> O
    O --> E["emitOrderUpdate"]
    E -->|"order:updated"| RO
    E -->|"order:updated"| RM
    U -.->|"disconnect / reconnect"| R["rejoin + REST resync"]
    R -->|"GET /api/orders/:id"| API["HTTP API"]
    API --> DB
    P["pending"] --> A["confirmed"]
    A --> PR["preparing"]
    PR --> D["delivering"]
    D --> C["delivered"]
    P --> X["cancelled"]
    A --> X
