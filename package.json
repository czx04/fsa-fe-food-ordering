{
  "name": "fsa-fe-food-ordering",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "workspaces": [
    "client",
    "client-dashboard",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n customer,dashboard,server -c cyan,yellow,green \"npm run dev --workspace client\" \"npm run dev --workspace client-dashboard\" \"npm run dev --workspace server\"",
    "dev:customer": "npm run dev --workspace client",
    "dev:client": "npm run dev --workspace client",
    "dev:dashboard": "npm run dev --workspace client-dashboard",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start": "npm run start --workspace server"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "typescript": "5.7.3"
  },
  "dependencies": {
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  }
}
