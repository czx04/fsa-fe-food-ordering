PORT=3000
NODE_ENV=development

# Client URLs (Dùng cho CORS, Email verification link, và redirects khi deploy)
CLIENT_ORIGIN=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174
CLIENT_URL=http://localhost:5173

# Database Config
MONGODB_DB_NAME=food_ordering
MONGODB_URI=mongodb://127.0.0.1:27017
# Chỉ đặt khi chủ động chạy script seed có xoá dữ liệu:
# CONFIRM_DESTRUCTIVE_SEED=seed:food_ordering

# JWT Security
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_jwt_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# VNPAY Config (Sandbox / Real / Mock)
VNPAY_MODE=real
VNP_TMNCODE=YOUR_VNP_TMNCODE
VNP_HASHSECRET=YOUR_VNP_HASHSECRET
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:5173/payment/success
VNPAY_PAYMENT_TIMEOUT_MINUTES=30

# Mailtrap / SMTP Config (Nếu không khai báo sẽ dùng Ethereal Test Account cho Dev)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SECURE=false
