NODE_ENV=production
PORT=3000

# External MongoDB (MongoDB Atlas or another managed MongoDB instance).
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=food_ordering

CLIENT_URL=https://food.example.com
CLIENT_ORIGIN=https://food.example.com
CLIENT_ORIGINS=https://food.example.com,https://admin.food.example.com

JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

VNPAY_MODE=real
VNP_TMNCODE=replace-with-vnpay-tmn-code
VNP_HASHSECRET=replace-with-vnpay-hash-secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=https://food.example.com/payment/success
VNPAY_PAYMENT_TIMEOUT_MINUTES=30

SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
SMTP_SECURE=false
