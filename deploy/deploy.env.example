# Docker Hub repository that receives the three image tags:
# client-<release>, dashboard-<release>, server-<release>
DOCKERHUB_USERNAME=your-dockerhub-username
DOCKERHUB_REPOSITORY=fsa-food-ordering

# Use "latest" for normal deployments. Use a commit SHA to pin or roll back.
RELEASE_TAG=latest

# Normally keep this default. It can point to server.env.example when validating Compose locally.
SERVER_ENV_FILE=./deploy/server.env

# Hostnames only, without https:// or a trailing slash.
CUSTOMER_DOMAIN=food.example.com
DASHBOARD_DOMAIN=admin.food.example.com
